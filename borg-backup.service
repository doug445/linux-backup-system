[Unit]
Description=Borg Backup to LUKS-encrypted sdb1
After=mnt-backup.mount
RequiresMountsFor=/mnt/backup

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/borg-backup.sh
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUSchedulingPolicy=idle

# Prevent backup from hogging resources
# MemoryHigh throttles; MemoryMax KILLED borg on a box with millions of files
# (its files cache alone is ~250 B per file), leaving a checkpoint and a lock.
MemoryHigh=2G
