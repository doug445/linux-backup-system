# testbed.conf — the two drives of the restore test bed. Keep one copy ON THE
# BACKUP DRIVE (<mount>/testbed/testbed.conf): every machine that plugs the
# drive in then finds it. Identify drives by their disk serial:
#   lsblk -dno NAME,SIZE,MODEL,SERIAL,TRAN

# The drive the test restore is written to — WIPED on every `prepare`.
TB_TARGET_SERIAL=""

# No spare drive: a sparse disk image of TB_TARGET_GIB on the backup drive
# instead (created if missing, attached as a loop device, never on one of
# this machine's own disks). A file gets no boot from the firmware — its
# verdict is the VM boot's, `testbed.sh collect --vm` → PASS-VM.
#TB_TARGET_IMAGE="/mnt/backup/testbed/$(hostname)-test.img"

# The backup drive the test archive is written to (never wiped).
TB_BACKUP_SERIAL=""

# Optional: the test archive goes to this mounted drive instead of the
# configured backup drive — another machine's production drive plugged in for
# the test; only the test bed's own borg-testbed-<host> repository is written.
#TB_BACKUP_MOUNT="/run/media/<user>/<drive>"

# Optional per-host additions to what a test archive leaves out:
# case "$(hostname)" in
#     bigbox) TB_EXTRA_EXCLUDES="/srv/media/* /var/lib/machines/*" ;;
# esac

# Optional: how much of the test drive the test bed uses, from its start (GiB,
# default 100; 0 = the whole drive). The rest stays unpartitioned.
#TB_TARGET_GIB=100

# Optional: USB transfer size during the test (KiB, 0 = leave the kernel's).
#TB_SECTORS_KB=128
