[Unit]
Description=Back in Time Backup to external drive
# deploy.sh replaces these paths at install time
RequiresMountsFor=/mnt/backup

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backintime-backup.sh
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUSchedulingPolicy=idle
# MemoryHigh throttles; MemoryMax KILLED borg on a box with millions of files
# (its files cache alone is ~250 B per file), leaving a checkpoint and a lock.
MemoryHigh=2G
