[Unit]
Description=Back up LUKS headers for every encrypted device
Documentation=file:/usr/local/sbin/luks-header-backup.sh
RequiresMountsFor=/mnt/backup

[Service]
Type=oneshot
# install.sh rewrites this for the host's layout.
Environment=BACKUP_MOUNT=/mnt/backup
ExecStart=/usr/local/sbin/luks-header-backup.sh
Nice=19
IOSchedulingClass=idle
